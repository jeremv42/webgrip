# Copier en .env (ignoré par git) et remplir.
# Mot de passe demandé à l'ouverture de WebGrip
WEBGRIP_PASSWORD=
# Clé de chiffrement de data/connections.json (et des cookies de session), 16 caractères au moins.
# La perdre = perdre les connexions enregistrées. Générer : openssl rand -base64 32
WEBGRIP_SECRET=
