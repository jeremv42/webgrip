# Copy to .env (ignored by git) and fill in.
# Password asked when opening WebGrip
WEBGRIP_PASSWORD=
# Encryption key of data/connections.json (and of the session cookies), at least 16 characters.
# Losing it = losing the saved connections. Generate one: openssl rand -base64 32
WEBGRIP_SECRET=

# Chat with Claude (right-hand panel), through the Claude Code CLI installed and logged in on this machine:
# it uses that account, with read-only database tools only. Off unless set to 1.
WEBGRIP_CHAT=0
# Let Claude run read-only queries itself and read their rows (1). Off by default: Claude only sees the structure
# (tables, columns, keys, indexes) and never a row, unless you attach a result to your message yourself.
WEBGRIP_CHAT_RUN_QUERY=0
# Claude Code executable (default: claude, looked up in PATH)
#WEBGRIP_CLAUDE_BIN=/home/me/.local/bin/claude
# Model (alias such as sonnet or opus, or a full name); default: the CLI's
#WEBGRIP_CHAT_MODEL=
