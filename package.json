    "concurrently": "^10.0.6",
    "monaco-editor": "^0.57.0",
    "monaco-sql-languages": "^1.3.0",
    "patch-package": "^8.0.1",
    "sql-formatter": "^15.9.0",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.44",
    "vuetify": "^4.3.1"
