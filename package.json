{
  "name": "webgrip",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "concurrently -k -n api,web -c blue,green \"node server/index.ts\" \"vite preview\"",
    "desktop:prepare": "vite build && node scripts/build-sidecar.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@tauri-apps/cli": "^2.12.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.18",
    "happy-dom": "^21.0.4",
    "marked": "^18.2.1",
    "monaco-editor": "^0.57.0",
    "monaco-sql-languages": "^1.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "patch-package": "^8.0.1",
    "sql-formatter": "^15.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.1"
  }
}
